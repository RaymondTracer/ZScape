<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ZScape.Controls"
        x:Class="ZScape.Views.LaunchGameDialog"
        Title="Launch Game"
        Width="860" Height="760"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="False">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,16">
            <TextBlock Text="Launch Game" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Choose the game files and launch mode. Disabled PWADs stay in the list but are omitted from the command line."
                       Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,8,12">
                <!-- Saved configurations -->
                <Border Classes="panel" Padding="14">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Configuration" Classes="header"/>
                                <TextBlock Text="Save a load order and launch settings for later." Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="SaveConfigButton" Content="Save..."
                                    Width="78" Height="28" Margin="8,0,0,0" Click="SaveConfigButton_Click"/>
                            <Button Grid.Column="2" x:Name="ClearConfigButton" Content="Reset"
                                    Width="68" Height="28" Margin="8,0,0,0" Click="ClearConfigButton_Click"/>
                            <Button Grid.Column="3" x:Name="DeleteConfigButton" Content="Delete"
                                    Width="68" Height="28" Margin="8,0,0,0" Click="DeleteConfigButton_Click"/>
                        </Grid>
                        <controls:PersistentComboBox x:Name="ConfigPresetComboBox"
                                                     HorizontalAlignment="Stretch"
                                                     SelectedIndex="0"
                                                     SelectionChanged="ConfigPresetComboBox_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- Launch mode -->
                <Border Classes="panel" Padding="14">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Launch mode" Classes="header"/>
                            <TextBlock Text="Play locally, or start a server using the selected load order." Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton x:Name="OfflineModeRadio" Content="Play _Offline"
                                         IsChecked="True" GroupName="LaunchMode"
                                         Click="LaunchModeRadio_Click"/>
                            <RadioButton x:Name="HostModeRadio" Content="_Host Server"
                                         GroupName="LaunchMode"
                                         Click="LaunchModeRadio_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="HostOptionsPanel" Spacing="8" IsVisible="False">
                            <TextBlock Text="Server type" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton x:Name="ListenServerRadio" Content="_Listen server (play + host)"
                                             IsChecked="True" GroupName="ServerType"/>
                                <RadioButton x:Name="DedicatedServerRadio" Content="_Dedicated server (host only)"
                                             GroupName="ServerType"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Game files -->
                <Border Classes="panel" Padding="14">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Game files" Classes="header"/>
                            <TextBlock Text="The order shown here is the order passed to Zandronum. Missing files remain visible so they can be repaired or disabled."
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Zandronum version" FontWeight="SemiBold"/>
                                <controls:PersistentComboBox x:Name="VersionComboBox"
                                                             HorizontalAlignment="Stretch"
                                                             SelectedIndex="0"
                                                             SelectionChanged="VersionComboBox_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" Margin="14,0,0,0">
                                <TextBlock Text="IWAD" FontWeight="SemiBold"/>
                                <controls:PersistentComboBox x:Name="IwadComboBox"
                                                             HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="PWAD load order" FontWeight="SemiBold"/>
                                <TextBlock Text="Use the checkboxes to isolate a file that causes a startup or load-order error."
                                           Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="EnableAllPwadButton" Content="Enable all"
                                    Height="28" Margin="8,0,0,0" Click="EnableAllPwadButton_Click"/>
                            <Button Grid.Column="2" x:Name="DisableAllPwadButton" Content="Disable all"
                                    Height="28" Margin="8,0,0,0" Click="DisableAllPwadButton_Click"/>
                            <Button Grid.Column="3" x:Name="AddPwadButton" Content="Add..."
                                    Width="68" Height="28" Margin="8,0,0,0" Click="AddPwadButton_Click"/>
                            <Button Grid.Column="4" x:Name="RemovePwadButton" Content="Remove"
                                    Width="76" Height="28" Margin="8,0,0,0" IsEnabled="False"
                                    Click="RemovePwadButton_Click"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <Button x:Name="MoveUpPwadButton" Content="▲" Width="32" Height="28"
                                        IsEnabled="False" ToolTip.Tip="Move selected file up"
                                        Click="MoveUpPwadButton_Click"/>
                                <Button x:Name="MoveDownPwadButton" Content="▼" Width="32" Height="28"
                                        IsEnabled="False" ToolTip.Tip="Move selected file down"
                                        Click="MoveDownPwadButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" MinHeight="170">
                            <Grid Height="230">
                                <controls:ResizableListView x:Name="PwadsListView" />
                                <TextBlock x:Name="PwadEmptyLabel"
                                           Text="No PWAD files added. Use Add... to build the load order."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Selected path" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBox Grid.Column="1" x:Name="PwadEditTextBox"
                                     HorizontalAlignment="Stretch"
                                     TextChanged="PwadEditTextBox_TextChanged"/>
                        </Grid>
                        <TextBlock x:Name="HostOptionalHint"
                                   Text="In Host Server mode, the Optional checkbox marks an enabled file for Zandronum's -optfile list. Optional files are not required for clients to join."
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
                    </StackPanel>
                </Border>

                <!-- Gameplay and host settings -->
                <Border Classes="panel" Padding="14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Gameplay settings" Classes="header"/>
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Map (optional)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="MapTextBox" Watermark="MAP01 or E1M1"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Skill level" FontWeight="SemiBold"/>
                                    <controls:PersistentComboBox x:Name="SkillComboBox" Width="230"
                                                                  HorizontalAlignment="Left" SelectedIndex="2">
                                        <ComboBoxItem Content="1 - I'm Too Young to Die"/>
                                        <ComboBoxItem Content="2 - Hey, Not Too Rough"/>
                                        <ComboBoxItem Content="3 - Hurt Me Plenty"/>
                                        <ComboBoxItem Content="4 - Ultra-Violence"/>
                                        <ComboBoxItem Content="5 - Nightmare!"/>
                                    </controls:PersistentComboBox>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" Margin="14,0,0,0">
                                <StackPanel x:Name="MaxPlayersPanel" Spacing="5">
                                    <TextBlock Text="Max players" FontWeight="SemiBold"/>
                                    <controls:NumericSpinner x:Name="MaxPlayersNumeric" Minimum="1" Maximum="64"
                                                             Value="8" Width="90" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel x:Name="MaxClientsPanel" Spacing="5" IsVisible="False">
                                    <TextBlock Text="Max clients" FontWeight="SemiBold"/>
                                    <TextBlock Text="Includes spectators and other connected clients." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                                    <controls:NumericSpinner x:Name="MaxClientsNumeric" Minimum="2" Maximum="64"
                                                             Value="32" Width="90" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="HostAdvancedPanel" Spacing="8" IsVisible="False">
                            <TextBlock Text="Server identity and passwords" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="125,*" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Server name" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ServerNameTextBox" Watermark="My Server"/>
                                <TextBlock Grid.Row="1" Text="Server password" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ServerPasswordTextBox" Watermark="Optional" PasswordChar="*" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Text="Join password" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="JoinPasswordTextBox" Watermark="Optional" PasswordChar="*" Margin="0,6,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,10,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0" x:Name="StatusLabel" Text=""
                       VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>
            <Button Grid.Column="1" x:Name="LaunchButton" Classes="accent" Content="_Launch"
                    MinWidth="100" Height="34" IsEnabled="False" Click="LaunchButton_Click"/>
            <Button Grid.Column="3" x:Name="CancelButton" Content="Cancel"
                    MinWidth="90" Height="34" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
