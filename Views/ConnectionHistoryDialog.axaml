<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ZScape.Controls"
        x:Class="ZScape.Views.ConnectionHistoryDialog"
        x:CompileBindings="False"
        Title="Connection History"
        Width="1050" Height="560"
        WindowStartupLocation="CenterOwner"
        MinWidth="760" MinHeight="420"
        ExtendClientAreaToDecorationsHint="False">
    
    <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto">
        <!-- Compact browser toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,220" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Recently Connected Servers"
                           FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Live server data is shown when a history entry matches the current browser."
                           Foreground="Gray" FontSize="11"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Search:"
                       VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox Grid.Column="2" x:Name="HistorySearchBox"
                     Watermark="Name, map, WAD, address…"
                     TextChanged="HistorySearchBox_TextChanged"/>
        </Grid>

        <controls:ResizableListView x:Name="HistoryListView"
                                    Grid.Row="1" Margin="0,0,0,8" />

        <!-- History identity settings -->
        <Border Grid.Row="2" Classes="panel" Padding="8" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Keep up to:" VerticalAlignment="Center"/>
                    <controls:NumericSpinner x:Name="MaxEntriesNumeric"
                                             Minimum="10" Maximum="500" Value="100"
                                             Width="70"/>
                    <TextBlock Text="entries" VerticalAlignment="Center"/>
                    <Border Width="16"/>
                    <TextBlock Text="Identify history entries by:"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="TrackingModeComboBox" Width="260"
                      SelectionChanged="TrackingModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Address — stable endpoint"/>
                        <ComboBoxItem Content="Server name — follows moves"/>
                        <ComboBoxItem Content="Address + name — exact pair"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="TrackingModeHelpText"
                           Margin="0,6,0,0" Foreground="Gray" FontSize="11"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Browser actions -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Button Grid.Column="0" x:Name="ReconnectButton" Classes="accent"
                    Content="Reconnect" Margin="0,0,8,0"
                    Click="ReconnectButton_Click"/>
            <Button Grid.Column="1" x:Name="CopyAddressButton"
                    Content="Copy Address" Margin="0,0,8,0"
                    Click="CopyAddressButton_Click"/>
            <Button Grid.Column="2" x:Name="RemoveButton"
                    Content="Remove" Margin="0,0,8,0"
                    Click="RemoveButton_Click"/>
            <Button Grid.Column="3" x:Name="ClearButton"
                    Content="Clear All" Margin="0,0,8,0"
                    Click="ClearButton_Click"/>
            <TextBlock Grid.Column="4" x:Name="InfoLabel"
                       Text="Double-click an entry to reconnect"
                       VerticalAlignment="Center" Foreground="Gray"/>
            <Button Grid.Column="5" x:Name="CloseButton" Content="Close"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
