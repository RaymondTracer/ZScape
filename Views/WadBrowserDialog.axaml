<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ZScape.Controls"
        x:Class="ZScape.Views.WadBrowserDialog"
        x:CompileBindings="False"
        Title="WAD Browser"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        MinWidth="750" MinHeight="450"
        ExtendClientAreaToDecorationsHint="False">
    
    <Grid Margin="10" RowDefinitions="Auto,*,Auto,45">
        <!-- Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"/>
                <Button x:Name="CancelScanButton"
                        Content="Cancel Scan"
                        IsEnabled="False"
                        ToolTip.Tip="Stop the current WAD folder scan and keep the previous results."
                        Click="CancelScanButton_Click"/>
                <Button x:Name="CacheAllHashesButton"
                        Content="Cache All Files Now"
                        ToolTip.Tip="Calculate full MD5 hashes in the background for local WAD files that are not excluded from caching."
                        Click="CacheAllHashesButton_Click"/>
                <Separator Width="1" Height="24" Margin="5,0"/>
                <TextBlock Text="Search:" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchTextBox" Width="200" TextChanged="SearchTextBox_TextChanged"/>
                <Button Content="Clear" Click="ClearSearch_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- WAD list -->
        <controls:ResizableListView x:Name="WadListView" Grid.Row="1" />
        
        <!-- Status and indeterminate scan progress. File discovery has no cheap
             total, so the live counters provide the meaningful progress state. -->
        <StackPanel Grid.Row="2" Spacing="5" Margin="0,5,0,0">
            <ProgressBar x:Name="ScanProgressBar"
                         Height="8"
                         IsIndeterminate="True"
                         IsVisible="False"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusLabel" Text="Loading..." VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="CountLabel" Text="0 files" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalSizeLabel" Text="0 MB" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        
        <!-- Button panel -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <Button Grid.Column="1" Content="Close" Width="80" Height="30" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
