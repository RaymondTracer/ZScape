<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ZScape.Controls"
        x:Class="ZScape.Controls.AdvancedSortDialog"
        x:CompileBindings="False"
        Title="Advanced Sorting"
        Width="680"
        Height="460"
        MinWidth="560"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="False">

    <Grid Margin="14" RowDefinitions="Auto,*,Auto,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Sort Levels" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="Level 1 is compared first. Equal rows continue to level 2, then level 3, and so on."
                       Foreground="Gray"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <controls:ResizableListView x:Name="SortLevelsListView" />
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              Margin="0,10,0,8">
            <Button x:Name="AddLevelButton"
                    Grid.Column="0"
                    Content="Add Level"
                    Click="AddLevelButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="RemoveLevelButton"
                    Grid.Column="1"
                    Content="Remove"
                    Click="RemoveLevelButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="MoveUpButton"
                    Grid.Column="2"
                    Content="Move Up"
                    Click="MoveUpButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="MoveDownButton"
                    Grid.Column="3"
                    Content="Move Down"
                    Click="MoveDownButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="ClearAllButton"
                    Grid.Column="4"
                    Content="Clear All"
                    Click="ClearAllButton_Click"/>
            <StackPanel Grid.Column="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText"
                           Foreground="Gray"
                           HorizontalAlignment="Right"/>
                <TextBlock x:Name="ValidationText"
                           Foreground="{DynamicResource ErrorBrush}"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Hidden columns can still be used as sort levels."
                       Foreground="Gray"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="2"
                    Content="Apply"
                    Width="90"
                    Classes="accent"
                    Click="ApplyButton_Click"/>
        </Grid>
    </Grid>
</Window>
